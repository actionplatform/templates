{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.0.0",
  "description": "{{ cookiecutter.description }}",
  "private": true,
  "license": "MIT",
  "author": "{{ cookiecutter.author }}",
  "type": "module",
  "engines": {
    "node": ">={{ cookiecutter._node_version }}"
  },
  "scripts": {
    "lint": "prettier --config .code_quality/.prettierrc.json --check \"**/*.md\"",
    "format": "prettier --config .code_quality/.prettierrc.json --write \"**/*.md\"",
    "test": "remark --rc-path .code_quality/.remarkrc.json --frail --quiet --no-stdout ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "remark-cli": "^12.0.0",
    "remark-validate-links": "^13.0.0"
  }
}
