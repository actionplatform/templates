{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.0.0",
  "description": "{{ cookiecutter.description }}",
  "private": true,
  "license": "{{ cookiecutter.__spdx or 'UNLICENSED' }}",
  "author": "{{ cookiecutter.author }}",
  "main": "expo-router/entry",
  "engines": {
    "node": ">={{ cookiecutter._node_version }}"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint --config .code_quality/eslint.config.js src tests && npm run format && npm run typecheck",
    "format": "prettier --config .code_quality/.prettierrc.json --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:write": "prettier --config .code_quality/.prettierrc.json --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:web": "expo export --platform web"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "expo": "~58.1.0",
    "expo-constants": "^58.0.16",
    "expo-linking": "^58.0.17",
    "expo-router": "~58.0.33",
    "expo-status-bar": "^58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "^3.10.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
