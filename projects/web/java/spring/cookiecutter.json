{
  "project_name": "My Project",
  "project_slug": "{{ cookiecutter.project_name|lower|replace(' ', '-') }}",
  "description": "Spring Boot web API",
  "author": "",
  "github_owner": "",
  "source_host": [
    "github",
    "gitlab",
    "bitbucket"
  ],
  "license": [
    "none",
    "mit",
    "apache-2.0"
  ],
  "__owner": "{{ cookiecutter.github_owner or 'example' }}",
  "__domain": "{{ {'gitlab': 'gitlab.com', 'bitbucket': 'bitbucket.org'}.get(cookiecutter.source_host, 'github.com') }}",
  "__spdx": "{{ {'mit': 'MIT', 'apache-2.0': 'Apache-2.0'}.get(cookiecutter.license, '') }}",
  "package_name": "{{ cookiecutter.project_slug|replace('-', '_') }}",
  "ci": [
    "github",
    "gitlab",
    "jenkins",
    "bitbucket"
  ],
  "java_package": "com.{% if cookiecutter.__owner[:1].isdigit() %}_{% endif %}{{ cookiecutter.__owner|lower|replace('-', '')|replace('_', '')|replace('.', '') }}.{{ cookiecutter.package_name }}",
  "java_package_dir": "{{ cookiecutter.java_package|replace('.', '/') }}",
  "_type": "web",
  "_stack": "java",
  "_language": "java",
  "_variant": "spring",
  "_copy_without_render": [
    ".github"
  ],
  "_java_version": "21"
}
