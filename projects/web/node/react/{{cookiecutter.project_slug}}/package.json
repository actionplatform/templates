{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.0.0",
  "private": true,
  "description": "{{ cookiecutter.description }}",
  "engines": {
    "node": ">={{ cookiecutter.node_version }}",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "webpack serve --env mode=development",
    "build": "webpack --env mode=production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.jsx --no-eslintrc --config .code_quality/.eslintrc.json --ignore-path .code_quality/.eslintignore --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --config .code_quality/.prettierrc.json --write src",
    "format:check": "prettier --config .code_quality/.prettierrc.json --check src"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.13.2",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.3.0",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
