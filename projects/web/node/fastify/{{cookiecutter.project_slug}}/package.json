{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.1.0",
  "description": "{{ cookiecutter.description }}",
  "private": true,
  "license": "MIT",
  "author": "{{ cookiecutter.author }}",
  "main": "dist/server.js",
  "engines": {
    "node": ">={{ cookiecutter.node_version }}"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p .code_quality/tsconfig.json",
    "lint": "eslint --config .code_quality/.eslintrc.json --no-eslintrc --ext .ts src tests",
    "format": "prettier --config .code_quality/.prettierrc.json --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:write": "prettier --config .code_quality/.prettierrc.json --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
