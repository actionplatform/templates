{
    "name": "{{ cookiecutter.__owner|lower }}/{{ cookiecutter.project_slug }}",
    "description": "{{ cookiecutter.description }}",
    "type": "project",
    "license": "{{ cookiecutter.__spdx or 'proprietary' }}",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test --config .code_quality/pint.json",
        "format": "pint --config .code_quality/pint.json",
        "analyse": "phpstan analyse -c .code_quality/phpstan.neon --memory-limit=512M",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "{{ cookiecutter._php_version }}.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
